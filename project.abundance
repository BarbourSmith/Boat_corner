              "code": "/** L cross-section of an aluminum angle: outer corner at the origin, one leg along +X and one along +Y. */\nfunction run(\n  legX: number = 50.8, // mm, leg along X\n  legY: number = 50.8, // mm, leg along Y\n  thickness: number = 3.175, // mm\n): Assembly {\n  const t = thickness;\n  const outline = replicad\n    .draw([0, 0])\n    .lineTo([legX, 0])\n    .lineTo([legX, t])\n    .lineTo([t, t])\n    .lineTo([t, legY])\n    .lineTo([0, legY])\n    .close();\n  return new Assembly({ geometry: outline });\n}\n",
              "compiledCode": "\"use strict\";\n/** L cross-section of an aluminum angle: outer corner at the origin, one leg along +X and one along +Y. */\nfunction run(legX = 50.8, // mm, leg along X\nlegY = 50.8, // mm, leg along Y\nthickness = 3.175) {\n    const t = thickness;\n    const outline = replicad\n        .draw([0, 0])\n        .lineTo([legX, 0])\n        .lineTo([legX, t])\n        .lineTo([t, t])\n        .lineTo([t, legY])\n        .lineTo([0, legY])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
